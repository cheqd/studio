# Request limits (all optional; defaults shown)
# Per-IP and per-customer rate limits, counted per instance in memory (a shared store or ingress limit is needed for an
# exact figure across several instances). Health, readiness and swagger paths are never limited.
# RATE_LIMIT_ENABLED="true"
# RATE_LIMIT_WINDOW_SECONDS="60"
# RATE_LIMIT_IP_MAX="1000"
# RATE_LIMIT_CUSTOMER_MAX="600"
# Behind a reverse proxy set this (hop count, or an Express trust-proxy value) so the client IP is used, not the proxy's
# TRUST_PROXY="1"
# JSON body limits: default for every route, and the larger one for /resource/create, /credentials/import, /admin/webhook
# JSON_BODY_LIMIT="1mb"
# JSON_BODY_LIMIT_LARGE="10mb"
# Largest status list length (entries)
# STATUS_LIST_MAX_LENGTH="1048576"
