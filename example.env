DEFAULT_FEE_PAYER_MNEMONIC="sketch mountain ....."


# Deprecation of POST /credential-status/create/encrypted (encrypted status list creation)
# Sent as `Deprecation: @<unix-seconds>` (RFC 9745). Optional: defaults to 2026-11-16T00:00:00Z. ISO 8601.
# ENCRYPTED_STATUS_LIST_DEPRECATION_DATE="2026-11-16T00:00:00Z"
# Sent as `Sunset: <HTTP-date>` (RFC 8594); once this instant has passed the endpoint returns 410 Gone.
# Must be set for the 410 to apply: if unset or invalid, no Sunset header is sent and 410 is never returned.
# A date in the past or equal to now returns 410 immediately; a future date gives a notice period first.
# Reading, checking and updating existing encrypted lists is never affected.
# ENCRYPTED_STATUS_LIST_SUNSET_DATE="2026-11-30T00:00:00Z"

# TEST_RUNNER
TEST_USER_EMAIL='test@cheqd.io'
TEST_USER_PASSWORD='...'
TEST_USER_API_KEY='caas_...'

# Request limits (all optional; defaults shown)
# Per-IP and per-customer rate limits, counted per instance in memory (a shared store or ingress limit is needed for an
# exact figure across several instances). Health, readiness and swagger paths are never limited.
# RATE_LIMIT_ENABLED="true"
# RATE_LIMIT_WINDOW_SECONDS="60"
# RATE_LIMIT_IP_MAX="1000"
# RATE_LIMIT_CUSTOMER_MAX="600"
# Behind a reverse proxy set this (hop count, or an Express trust-proxy value) so the client IP is used, not the proxy's
# TRUST_PROXY="1"
# JSON body limits: default for every route, and the larger one for /resource/create, /credentials/import, /admin/webhook
# JSON_BODY_LIMIT="1mb"
# JSON_BODY_LIMIT_LARGE="10mb"
# Largest status list length (entries)
# STATUS_LIST_MAX_LENGTH="1048576"
# TEMPORARY ESCAPE HATCH, off by default, for one release only. Veramo is retired: every NEW DID, key, status list and
# credential goes to Credo. With this set to "true" AND a featureFlag engine row of "veramo", new artefacts of that
# customer and route are created on Veramo again, and each one logs `veramo-new-artefact-override`. Existing artefacts
# are never affected. See docs/engine-routing.md.
# VERAMO_NEW_ARTEFACT_OVERRIDE="false"
# The portal's credential screens (issue, verify, issued, status lists) are shown to customers who issued, verified or
# created a status list before this date (ISO), and to anyone staff switch on. Set it to the release date so the rule
# does not change under people afterwards. Unset: all history counts.
# CREDENTIAL_SCREENS_HISTORY_CUTOFF="2026-12-08T00:00:00Z"

# Graceful shutdown: on SIGTERM/SIGINT, how long to wait for in-flight requests and queued ledger writes before exiting 1.
# Default 25. The platform's termination grace period must be at least this plus a few seconds (platforms usually kill at 30).
# SHUTDOWN_GRACE_SECONDS="25"

# Key export and account deletion require a sign-in no older than this (Logto auth_time claim). Default 300.
# FRESH_SIGNIN_MAX_AGE_SECONDS="300"
# Minimum length of the password that encrypts exported keys (minimum and default 12; lower values are raised to 12).
# KEY_EXPORT_MIN_PASSWORD_LENGTH="12"
# Maximum key exports running at once per process (each uses about 128 MB for scrypt). Integer >= 1, default 2.
# Each customer is also limited to one export at a time. Excess requests get 429 EXPORT_BUSY with Retry-After.
# KEY_EXPORT_MAX_CONCURRENCY="2"
