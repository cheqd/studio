## Default/unused values are commented out

# General
APPLICATION_BASE_URL="http://localhost:3000"
MAINNET_RPC_URL="https://rpc.cheqd.net:443"
TESTNET_RPC_URL="https://rpc.cheqd.network:443"
RESOLVER_URL="https://resolver.cheqd.net/1.0/identifiers/"
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# External Veramo KMS Database
ENABLE_EXTERNAL_DB="false"
EXTERNAL_DB_CONNECTION_URL="postgres://<user>:<password>@<host>:<port>/<database>"
EXTERNAL_DB_ENCRYPTION_KEY="<db-encryption-key>"
EXTERNAL_DB_CERT="<path/to/extenal-db-cert>"
# Studio's main Postgres pool. Defaults shown (integers; timeouts in milliseconds). Waiting for a free connection
# longer than the connection timeout fails the query instead of queueing without limit.
# EXTERNAL_DB_POOL_MAX="10"
# EXTERNAL_DB_POOL_IDLE_TIMEOUT_MS="10000"
# EXTERNAL_DB_POOL_CONNECTION_TIMEOUT_MS="30000"
# Dedicated pool for the per-payer ledger locks (one connection per payer writing at once, kept out of the main pool
# so ledger writes cannot starve it). Defaults shown. Count both pools, per instance, in the cluster's max_connections.
# EXTERNAL_DB_LOCK_POOL_MAX="10"
# EXTERNAL_DB_LOCK_POOL_IDLE_TIMEOUT_MS="30000"
# EXTERNAL_DB_LOCK_POOL_CONNECTION_TIMEOUT_MS="2000"
# Idempotency keys (agent routes). Settled keys and their replay responses are kept for the retention below, stored
# encrypted with EXTERNAL_DB_ENCRYPTION_KEY, then deleted a batch at a time when new keys are recorded. Defaults shown.
# IDEMPOTENCY_RETENTION_HOURS="24"
# IDEMPOTENCY_PURGE_BATCH="100"
# IDEMPOTENCY_PURGE_INTERVAL_MS="60000"
# Credo engine. Only read when a feature flag selects the Credo engine: Studio starts without any of these.
# Credo's Askar store is a separate database on the same cluster as Studio's (not a schema in Studio's database),
# with its own app role. Create both once with scripts/credo-database-provisioning.sql; see
# docs/credo-database-provisioning.md. Host, port and TLS come from EXTERNAL_DB_CONNECTION_URL.
# CREDO_DB_NAME="studio_credo"
# CREDO_DB_USER="<credo-app-role>"
# CREDO_DB_PASSWORD="<credo-app-role-password>"
# Askar store key: a raw 32-byte key, as 64 hex characters or base64 (for example: openssl rand -hex 32).
# REQUIRED for the Credo engine, with no default and no derivation from EXTERNAL_DB_ENCRYPTION_KEY. It MUST differ
# in every environment (staging and production never share it) and MUST be escrowed out of band, separately from
# database backups: if it is lost the records in the Credo store cannot be read.
# CREDO_STORE_KEY="<64-hex-characters>"
# Askar connection pool (its own pool, in addition to Studio's). Defaults shown; count maxConnections in the
# cluster's connection budget. idleTimeout and connectTimeout are in seconds.
# CREDO_DB_MAX_CONNECTIONS="5"
# CREDO_DB_IDLE_TIMEOUT="30"
# CREDO_DB_CONNECT_TIMEOUT="10"

# LogTo
ENABLE_AUTHENTICATION="false"
# With NODE_ENV=production (the Docker image default) the process refuses to start unless ENABLE_AUTHENTICATION and
# ENABLE_EXTERNAL_DB are both exactly "true". Set the override below only for a deliberate, documented exception.
# ALLOW_INSECURE_PRODUCTION_WITHOUT_AUTHENTICATION="true"
LOGTO_ENDPOINT="http://localhost:3001"
LOGTO_APP_ID="ldfsr...rq432"
LOGTO_APP_SECRET="sdf...sdf"
# Optional: comma-separated IDs of native LogTo apps (e.g. the SDK quickstart login) whose ID tokens are accepted
LOGTO_CLI_APP_IDS=""
LOGTO_M2M_APP_ID="aaaa...ddddd"
LOGTO_M2M_APP_SECRET="aaaa...ddddd"
LOGTO_MANAGEMENT_API="https://default.logto.app/api"
LOGTO_DEFAULT_RESOURCE_URL="http://localhost:3000"
LOGTO_WEBHOOK_SECRET="sdf...sdf"
LOGTO_DEFAULT_ROLE_ID="sdlkfj"
LOGTO_TESTNET_ROLE_ID="asdf"
LOGTO_MAINNET_ROLE_ID="sdklfj"
COOKIE_SECRET="sdf...sdf"

# Provider validation settings
PROVIDER_ENCRYPTION_KEY=your-32-character-hex-key-here
DOCK_MASTER_API_KEY=dock-master-account-key
PARADYM_MASTER_API_KEY=paradym-master-account-key
HOVI_MASTER_API_KEY=hovi-master-account-key
PROVIDER_EXPORT_PASSWORD=password-with-lowercase-uppercase-number-specialchar
# Faucet settings
# Max CHEQ a customer can request via POST /account/faucet per calendar month (UTC)
# FAUCET_MONTHLY_LIMIT_CHEQ="100000"
# Max CHEQ a single testnet address can hold before the faucet stops topping it up (defaults to the monthly limit)
# FAUCET_ADDRESS_CAP_CHEQ="100000"
# Seconds POST /account/faucet caches a customer's Stripe subscription status and plan (0 disables)
# FAUCET_SUBSCRIPTION_CACHE_SECONDS="60"
# Minimum seconds between two POST /account/faucet requests from one customer (0 disables)
# FAUCET_MIN_INTERVAL_SECONDS="10"
# Seconds an unconfirmed faucet quota reservation keeps counting before it is treated as abandoned
# FAUCET_PENDING_TIMEOUT_SECONDS="600"
# Seconds recent requests for an address are subtracted from its room under the address cap
# FAUCET_BALANCE_SETTLE_SECONDS="20"
# Months of faucet request history to keep (0 keeps everything)
# FAUCET_REQUEST_RETENTION_MONTHS="13"
# Seconds to wait for the faucet service to answer before giving up
# FAUCET_REQUEST_TIMEOUT_SECONDS="30"
# Ledger indexer for the staff faucet-to-ledger analytics (off by default). Needs the ledgerAddressActivity migration.
# LEDGER_INDEXER_ENABLED="false"
# Source: the cheqd data-api, which serves both networks (Studio queries testnet)
# LEDGER_INDEXER_SOURCE_URL="https://data-api.cheqd.io"
# Addresses checked per run (max 200), and hours before a checked address is checked again
# LEDGER_INDEXER_BATCH_SIZE="25"
# LEDGER_INDEXER_RECHECK_HOURS="24"
# Minimum minutes between runs started by one process (0 = every trigger)
# LEDGER_INDEXER_RUN_INTERVAL_MINUTES="10"
# Per address: results per page (max 100), pages read per endpoint (max 50), seconds per request, retries after a failure
# LEDGER_INDEXER_PAGE_SIZE="100"
# LEDGER_INDEXER_MAX_PAGES="10"
# LEDGER_INDEXER_TIMEOUT_SECONDS="15"
# LEDGER_INDEXER_MAX_RETRIES="3"
# Share of funded addresses that must be checked before the ledger figures are shown
# LEDGER_INDEXER_MIN_COVERAGE_PERCENT="90"
# FAUCET_URI="https://faucet-api.cheqd.network/credit"
# FAUCET_API_KEY="faucet-api-key"
# FAUCET_ACCESS_CLIENT_ID="cloudflare-access-client-id"
# FAUCET_ACCESS_CLIENT_SECRET="cloudflare-access-client-secret"

# CHEQ market data (CoinGecko) - powers the USD figures in GET /account/balances
# COINGECKO_API_URL="https://api.coingecko.com/api/v3"
# COINGECKO_TOKEN_ID="cheqd-network"
# COINGECKO_API_KEY=""
# CHEQ_USD_RATE_CACHE_TTL="300"

